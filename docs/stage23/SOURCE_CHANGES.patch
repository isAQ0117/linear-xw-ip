diff --git a/rtl/xw_activation_buffer.v b/rtl/xw_activation_buffer.v
new file mode 100644
index 0000000..d18e741
--- /dev/null
+++ b/rtl/xw_activation_buffer.v
@@ -0,0 +1,152 @@
+// Stage 2: complete M=1 X; 144-bit / 8-lane synchronous storage.
+module xw_activation_buffer #(
+    parameter integer MAX_K = 12288
+)(
+    input  wire         clk,
+    input  wire         rst_n,
+    input  wire         abort,
+    input  wire         load_begin,
+    input  wire  [15:0] load_k,
+    input  wire         wr_valid,
+    output wire         wr_ready,
+    input  wire [143:0] wr_data,
+    input  wire   [7:0] wr_mask,
+    input  wire   [7:0] wr_exp,
+    input  wire  [15:0] wr_word_index,
+    input  wire         wr_last,
+    output wire         loaded,
+    output reg          fault,
+    output reg    [7:0] error_code,
+    input  wire         rd_req,
+    input  wire  [15:0] rd_word_index,
+    output wire         rd_valid,
+    output wire [143:0] rd_data,
+    output wire   [7:0] rd_exp,
+    output reg    [7:0] rd_mask
+);
+
+    // RAM 不复位；仅有效标志和当前装载配置复位。
+    localparam integer DEPTH = (MAX_K + 7) / 8;
+    localparam integer GROUPS = (MAX_K + 127) / 128;
+    reg [143:0] words [0:DEPTH-1];
+    reg   [7:0] exponents [0:GROUPS-1];
+    reg [143:0] ram_read_data;
+    reg   [7:0] ram_read_exp;
+    reg         read_seen;
+    reg         loaded_reg;
+    reg         read_valid_reg;
+    reg         loading;
+    reg  [15:0] active_k;
+    reg  [15:0] total_words;
+    reg  [15:0] written;
+    reg   [7:0] current_exp;
+    wire  [7:0] expected_mask;
+    wire        final_word;
+    wire  [7:0] read_mask;
+    wire        control_conflict;
+    wire        invalid_write;
+    wire        write_enable;
+    wire        read_enable;
+
+    generate
+        if (MAX_K < 1 || MAX_K > 65535) begin : g_invalid_parameters
+            XW_INVALID_ACTIVATION_BUFFER_PARAMETERS u_must_fail_elaboration ();
+        end
+    endgenerate
+
+    assign final_word = (written + 16'd1 == total_words);
+    assign expected_mask = final_word && active_k[2:0] != 0 ?
+                           (8'hff >> (8 - active_k[2:0])) : 8'hff;
+    assign read_mask = rd_word_index + 16'd1 == total_words && active_k[2:0] != 0 ?
+                       (8'hff >> (8 - active_k[2:0])) : 8'hff;
+    assign wr_ready = rst_n && !abort && !fault && loading && !load_begin && !rd_req;
+    assign loaded = rst_n && !abort && !fault && loaded_reg;
+    assign rd_valid = rst_n && !abort && !fault && read_valid_reg;
+
+    assign rd_data = read_seen ? ram_read_data : 144'd0;
+    assign rd_exp = read_seen ? ram_read_exp : 8'd0;
+    assign control_conflict = (load_begin && (loading || wr_valid || rd_req)) ||
+                              (wr_valid && rd_req) ||
+                              (load_begin && (load_k == 0 || load_k > MAX_K)) ||
+                              (rd_req && (!loaded_reg || rd_word_index >= total_words));
+    assign invalid_write = !loading || wr_word_index != written || written >= total_words ||
+                           written >= DEPTH || wr_mask != expected_mask || wr_last != final_word ||
+                           (written[3:0] != 0 && wr_exp != current_exp) ||
+                           (final_word && active_k[2:0] != 0 &&
+                            (wr_data >> (active_k[2:0]*18)) != 144'd0);
+    assign write_enable = rst_n && !abort && !fault && !control_conflict &&
+                          !load_begin && wr_valid && !invalid_write;
+    assign read_enable = rst_n && !abort && !fault && !control_conflict &&
+                         !load_begin && !wr_valid && rd_req;
+
+    // RAM 独立无复位时序块，保证全宽同步读写而非阵列触发器。
+    always @(posedge clk) begin
+        if (write_enable) begin
+            words[wr_word_index] <= wr_data;
+            if (written[3:0] == 0)
+                exponents[written >> 4] <= wr_exp;
+        end
+        if (read_enable) begin
+            ram_read_data <= words[rd_word_index];
+            ram_read_exp <= exponents[rd_word_index >> 4];
+        end
+    end
+
+    // 单写口 / 同步读；读写冲突不依赖 RAM 的 read-during-write 模式。
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            loaded_reg <= 1'b0;
+            read_valid_reg <= 1'b0;
+            loading <= 1'b0;
+            fault <= 1'b0;
+            error_code <= 8'd0;
+            active_k <= 16'd0;
+            total_words <= 16'd0;
+            written <= 16'd0;
+            current_exp <= 8'd0;
+            read_seen <= 1'b0;
+            rd_mask <= 8'd0;
+        end else begin
+            read_valid_reg <= 1'b0;
+            if (fault || abort) begin
+                loaded_reg <= 1'b0;
+                loading <= 1'b0;
+                if (!fault) begin
+                    fault <= 1'b1;
+                    error_code <= 8'h40;
+                end
+            end else if (control_conflict) begin
+                fault <= 1'b1;
+                error_code <= 8'h40;
+                loaded_reg <= 1'b0;
+                loading <= 1'b0;
+            end else if (load_begin) begin
+                loaded_reg <= 1'b0;
+                loading <= 1'b1;
+                active_k <= load_k;
+                total_words <= ({1'b0, load_k} + 17'd7) >> 3;
+                written <= 16'd0;
+            end else if (wr_valid) begin
+                if (invalid_write) begin
+                    fault <= 1'b1;
+                    error_code <= 8'h40;
+                    loaded_reg <= 1'b0;
+                    loading <= 1'b0;
+                end else begin
+                    if (written[3:0] == 0) begin
+                        current_exp <= wr_exp;
+                    end
+                    written <= written + 16'd1;
+                    if (final_word) begin
+                        loaded_reg <= 1'b1;
+                        loading <= 1'b0;
+                    end
+                end
+            end else if (rd_req) begin
+                read_seen <= 1'b1;
+                rd_mask <= read_mask;
+                read_valid_reg <= 1'b1;
+            end
+        end
+    end
+endmodule
diff --git a/rtl/xw_axis_bfp18_input.v b/rtl/xw_axis_bfp18_input.v
new file mode 100644
index 0000000..3dbfaf0
--- /dev/null
+++ b/rtl/xw_axis_bfp18_input.v
@@ -0,0 +1,202 @@
+// Stage 2: M=1 BFP18/TUSER V2 parser, one element per unpack cycle.
+// rst_n is the common asynchronously asserted, synchronously released reset.
+module xw_axis_bfp18_input #(
+    parameter integer MAX_K = 12288
+)(
+    input  wire         clk,
+    input  wire         rst_n,
+    input  wire         abort,
+    input  wire         job_begin,
+    input  wire  [31:0] job_id,
+    input  wire  [15:0] job_k,
+    input  wire [511:0] s_axis_tdata,
+    input  wire         s_axis_tvalid,
+    output wire         s_axis_tready,
+    input  wire  [63:0] s_axis_tkeep,
+    input  wire         s_axis_tlast,
+    input  wire [127:0] s_axis_tuser,
+    output reg          wr_valid,
+    input  wire         wr_ready,
+    output reg  [143:0] wr_data,
+    output reg    [7:0] wr_mask,
+    output reg    [7:0] wr_exp,
+    output reg   [15:0] wr_word_index,
+    output reg          wr_last,
+    output reg          done,
+    output reg          fault,
+    output reg    [7:0] error_code
+);
+
+    // 参数、游标与单 Beat 暂存；pack 跨 Beat 保留。
+    reg         active;
+    reg  [31:0] active_id;
+    reg  [15:0] active_k;
+    reg   [8:0] group_id;
+    reg   [7:0] group_offset;
+    reg   [7:0] group_exp;
+    reg         input_end;
+    reg [511:0] beat_shift;
+    reg   [5:0] remaining;
+    reg   [7:0] beat_exp;
+    reg         beat_final;
+    reg [143:0] pack_data;
+    reg   [2:0] pack_lanes;
+    reg  [15:0] next_word;
+    reg [143:0] packed_next;
+    reg   [7:0] check_error;
+    wire [16:0] group_start;
+    wire [16:0] group_remaining;
+    wire  [7:0] group_len;
+    wire  [7:0] elements_left;
+    wire  [5:0] beat_count;
+    wire  [6:0] keep_bytes;
+    wire [63:0] keep_expected;
+    wire        group_last;
+    wire        tensor_last;
+
+    generate
+        if (MAX_K < 1 || MAX_K > 65535) begin : g_invalid_parameters
+            XW_INVALID_AXIS_INPUT_PARAMETERS u_must_fail_elaboration ();
+        end
+    endgenerate
+
+    assign group_start = {1'b0, group_id, 7'd0};
+    assign group_remaining = {1'b0, active_k} - group_start;
+    assign group_len = group_remaining >= 17'd128 ? 8'd128 : group_remaining[7:0];
+    assign elements_left = group_len - group_offset;
+    assign beat_count = elements_left > 8'd28 ? 6'd28 : elements_left[5:0];
+    assign keep_bytes = (beat_count * 18 + 7) / 8;
+    assign keep_expected = 64'hffffffffffffffff >> (64 - keep_bytes);
+    assign group_last = ({2'd0, beat_count} + group_offset == group_len);
+    assign tensor_last = group_last && (group_start + {9'd0, group_len} == {1'b0, active_k});
+    assign s_axis_tready = rst_n && !abort && !fault && !job_begin && active &&
+                          !input_end && remaining == 0 && !wr_valid;
+
+    // 冻结格式检查；只在 AXIS 握手沿使用结果。
+    always @* begin
+        check_error = 8'h00;
+        if (s_axis_tuser[127:104] != 24'd0 ||
+            s_axis_tuser[103:96] != 8'hb2 ||
+            s_axis_tuser[95:89] != 7'd0 ||
+            s_axis_tuser[63:57] != 7'd0 ||
+            s_axis_tuser[31:0] != active_id)
+            check_error = 8'h10;
+        else if (s_axis_tuser[47:32] != 16'd0 ||
+                 s_axis_tuser[56:48] != group_id ||
+                 s_axis_tuser[79:72] != group_len ||
+                 s_axis_tuser[87:80] != group_offset ||
+                 (group_offset != 0 && s_axis_tuser[71:64] != group_exp))
+            check_error = 8'h11;
+        else if (s_axis_tkeep != keep_expected ||
+                 (s_axis_tdata >> (beat_count * 18)) != 512'd0)
+            check_error = 8'h12;
+        else if (s_axis_tlast != group_last || s_axis_tuser[88] != tensor_last)
+            check_error = 8'h13;
+        packed_next = pack_data;
+        packed_next[pack_lanes*18 +: 18] = beat_shift[17:0];
+    end
+
+    // 解包、8-lane 打包、输出保持与不可自动恢复的故障。
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            active <= 1'b0;
+            active_id <= 32'd0;
+            active_k <= 16'd0;
+            group_id <= 9'd0;
+            group_offset <= 8'd0;
+            group_exp <= 8'd0;
+            input_end <= 1'b0;
+            beat_shift <= 512'd0;
+            remaining <= 6'd0;
+            beat_exp <= 8'd0;
+            beat_final <= 1'b0;
+            pack_data <= 144'd0;
+            pack_lanes <= 3'd0;
+            next_word <= 16'd0;
+            wr_valid <= 1'b0;
+            wr_data <= 144'd0;
+            wr_mask <= 8'd0;
+            wr_exp <= 8'd0;
+            wr_word_index <= 16'd0;
+            wr_last <= 1'b0;
+            done <= 1'b0;
+            fault <= 1'b0;
+            error_code <= 8'd0;
+        end else begin
+            done <= 1'b0;
+            if (fault || abort) begin
+                active <= 1'b0;
+                wr_valid <= 1'b0;
+                remaining <= 6'd0;
+                if (!fault) begin
+                    fault <= 1'b1;
+                    error_code <= 8'h40;
+                end
+            end else if (job_begin && (active || wr_valid || job_k == 0 || job_k > MAX_K)) begin
+                fault <= 1'b1;
+                error_code <= 8'h40;
+                wr_valid <= 1'b0;
+                active <= 1'b0;
+            end else if (job_begin) begin
+                active <= 1'b1;
+                active_id <= job_id;
+                active_k <= job_k;
+                group_id <= 9'd0;
+                group_offset <= 8'd0;
+                group_exp <= 8'd0;
+                input_end <= 1'b0;
+                remaining <= 6'd0;
+                pack_data <= 144'd0;
+                pack_lanes <= 3'd0;
+                next_word <= 16'd0;
+            end else if (s_axis_tvalid && s_axis_tready) begin
+                if (check_error != 0) begin
+                    fault <= 1'b1;
+                    error_code <= check_error;
+                    active <= 1'b0;
+                    wr_valid <= 1'b0;
+                    remaining <= 6'd0;
+                end else begin
+                    beat_shift <= s_axis_tdata;
+                    remaining <= beat_count;
+                    beat_exp <= s_axis_tuser[71:64];
+                    beat_final <= tensor_last;
+                    input_end <= tensor_last;
+                    if (group_offset == 0)
+                        group_exp <= s_axis_tuser[71:64];
+                    if (group_last) begin
+                        group_id <= group_id + 9'd1;
+                        group_offset <= 8'd0;
+                    end else begin
+                        group_offset <= group_offset + {2'd0, beat_count};
+                    end
+                end
+            end else if (wr_valid) begin
+                if (wr_ready) begin
+                    wr_valid <= 1'b0;
+                    if (wr_last) begin
+                        done <= 1'b1;
+                        active <= 1'b0;
+                    end
+                end
+            end else if (remaining != 0) begin
+                beat_shift <= beat_shift >> 18;
+                remaining <= remaining - 6'd1;
+                if (pack_lanes == 3'd7 || (beat_final && remaining == 6'd1)) begin
+                    wr_valid <= 1'b1;
+                    wr_data <= packed_next;
+                    wr_mask <= 8'hff >> (7 - pack_lanes);
+                    wr_exp <= beat_exp;
+                    wr_word_index <= next_word;
+                    wr_last <= beat_final && remaining == 6'd1;
+                    next_word <= next_word + 16'd1;
+                    pack_data <= 144'd0;
+                    pack_lanes <= 3'd0;
+                end else begin
+                    pack_data <= packed_next;
+                    pack_lanes <= pack_lanes + 3'd1;
+                end
+            end
+        end
+    end
+endmodule
diff --git a/rtl/xw_ddr_addr_gen.v b/rtl/xw_ddr_addr_gen.v
new file mode 100644
index 0000000..9809b60
--- /dev/null
+++ b/rtl/xw_ddr_addr_gen.v
@@ -0,0 +1,225 @@
+// Stage 3: Layout V3 validation and one logical Group/Row -> physical ranges.
+// DDR_MAX_BURST_BEATS=0 deliberately requires explicit platform selection.
+module xw_ddr_addr_gen #(
+    parameter integer MAX_N = 12288,
+    parameter integer MAX_K = 12288,
+    parameter integer DDR_MAX_BURST_BEATS = 0
+)(
+    input  wire         clk,
+    input  wire         rst_n,
+    input  wire         abort,
+    input  wire         cfg_begin,
+    input  wire  [15:0] cfg_n,
+    input  wire  [15:0] cfg_k,
+    input  wire  [28:0] cfg_weight_base,
+    input  wire  [28:0] cfg_scale_base,
+    output reg          cfg_done,
+    output reg          cfg_error,
+    output reg    [7:0] cfg_error_code,
+    input  wire         load_valid,
+    output wire         load_ready,
+    input  wire         load_kind,
+    input  wire  [15:0] load_index,
+    output wire         scale_load_begin,
+    output wire         weight_load_begin,
+    output wire  [15:0] load_words,
+    output wire  [15:0] load_scales,
+    output wire  [15:0] load_k,
+    output wire         load_done,
+    output wire         cmd_valid,
+    input  wire         cmd_ready,
+    output wire  [28:0] cmd_addr_start,
+    output wire  [28:0] cmd_addr_end,
+    output wire  [15:0] cmd_beats,
+    output wire         cmd_kind,
+    input  wire         range_done,
+    input  wire         range_error,
+    input  wire   [7:0] range_error_code,
+    input  wire         buffer_loaded,
+    input  wire         buffer_error,
+    input  wire   [7:0] buffer_error_code,
+    output wire  [15:0] segment_offset,
+    output reg          fault,
+    output reg    [7:0] error_code
+);
+
+    // 配置以64bit计算完整独占边界，不允许29bit截断后再校验。
+    localparam [2:0] S_IDLE = 3'd0, S_INIT = 3'd1, S_REQUEST = 3'd2,
+                     S_RECEIVE = 3'd3, S_COMMIT = 3'd4, S_LOADED = 3'd5;
+    reg         load_done_reg;
+    reg   [2:0] state;
+    reg         configured;
+    reg  [15:0] active_n;
+    reg  [15:0] active_k;
+    reg  [28:0] weight_base;
+    reg  [28:0] scale_base;
+    reg  [15:0] weight_words;
+    reg  [15:0] scale_words;
+    reg  [15:0] n_groups;
+    reg  [15:0] k_blocks;
+    reg         kind;
+    reg  [28:0] object_base;
+    reg  [15:0] total_words;
+    reg  [15:0] offset;
+    wire [63:0] cfg_rw;
+    wire [63:0] cfg_rs;
+    wire [63:0] cfg_groups;
+    wire [63:0] cfg_wend;
+    wire [63:0] cfg_send;
+    wire [63:0] index_base;
+    wire [63:0] segment_start;
+    wire [63:0] segment_end;
+    wire [15:0] remaining_words;
+    wire        blocked;
+
+    generate
+        if (MAX_N < 1 || MAX_N > 65535 || MAX_K < 1 || MAX_K > 65535 ||
+            DDR_MAX_BURST_BEATS < 1 || DDR_MAX_BURST_BEATS > 65535) begin : g_invalid_parameters
+            XW_INVALID_ADDR_GEN_PARAMETERS u_must_fail_elaboration ();
+        end
+    endgenerate
+
+    assign cfg_rw = ({48'd0, cfg_k} + 64'd63) >> 6;
+    assign cfg_rs = ({48'd0, cfg_k} + 64'd2047) >> 11;
+    assign cfg_groups = ({48'd0, cfg_n} + 64'd127) >> 7;
+    assign cfg_wend = {35'd0, cfg_weight_base} + 64'd8 * {48'd0, cfg_n} * cfg_rw;
+    assign cfg_send = {35'd0, cfg_scale_base} + 64'd8 * cfg_groups * cfg_rs;
+    assign index_base = load_kind ?
+        {35'd0, weight_base} + 64'd8 * {48'd0, load_index} * {48'd0, weight_words} :
+        {35'd0, scale_base} + 64'd8 * {48'd0, load_index} * {48'd0, scale_words};
+    assign remaining_words = total_words - offset;
+    assign cmd_beats = remaining_words > DDR_MAX_BURST_BEATS ? DDR_MAX_BURST_BEATS : remaining_words;
+    assign segment_start = {35'd0, object_base} + 64'd8 * {48'd0, offset};
+    assign segment_end = segment_start + 64'd8 * ({48'd0, cmd_beats} - 64'd1);
+    assign blocked = !rst_n || abort || fault || range_error || buffer_error;
+    // 同沿Receiver故障可在NBA后出现，公开完成必须立即屏蔽。
+    assign load_done = load_done_reg && !blocked;
+    assign load_ready = !blocked && configured && state == S_IDLE && !cfg_begin;
+    assign scale_load_begin = !blocked && state == S_INIT && !kind;
+    assign weight_load_begin = !blocked && state == S_INIT && kind;
+    assign load_words = total_words;
+    assign load_scales = k_blocks;
+    assign load_k = active_k;
+    assign cmd_valid = !blocked && state == S_REQUEST &&
+                       cmd_beats != 0 && segment_end < 64'd536870912;
+    assign cmd_addr_start = segment_start[28:0];
+    assign cmd_addr_end = segment_end[28:0];
+    assign cmd_kind = kind;
+    assign segment_offset = offset;
+
+    // INIT仅初始化一次；COMMIT保护最后寄存Beat的逻辑写地址。
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            state <= S_IDLE;
+            configured <= 1'b0;
+            active_n <= 16'd0;
+            active_k <= 16'd0;
+            weight_base <= 29'd0;
+            scale_base <= 29'd0;
+            weight_words <= 16'd0;
+            scale_words <= 16'd0;
+            n_groups <= 16'd0;
+            k_blocks <= 16'd0;
+            kind <= 1'b0;
+            object_base <= 29'd0;
+            total_words <= 16'd0;
+            offset <= 16'd0;
+            cfg_done <= 1'b0;
+            cfg_error <= 1'b0;
+            cfg_error_code <= 8'd0;
+            load_done_reg <= 1'b0;
+            fault <= 1'b0;
+            error_code <= 8'd0;
+        end else begin
+            cfg_done <= 1'b0;
+            load_done_reg <= 1'b0;
+            if (fault) begin
+                configured <= 1'b0;
+            end else if (range_error || buffer_error || abort) begin
+                fault <= 1'b1;
+                error_code <= range_error ? range_error_code :
+                              (buffer_error ? buffer_error_code : 8'h40);
+                configured <= 1'b0;
+            end else if (cfg_begin && (state != S_IDLE || load_valid)) begin
+                fault <= 1'b1;
+                error_code <= 8'h40;
+                configured <= 1'b0;
+            end else if (cfg_begin) begin
+                cfg_done <= 1'b1;
+                cfg_error <= 1'b0;
+                cfg_error_code <= 8'd0;
+                configured <= 1'b0;
+                if (cfg_n == 0 || cfg_k == 0 || cfg_n > MAX_N || cfg_k > MAX_K) begin
+                    cfg_error <= 1'b1;
+                    cfg_error_code <= 8'h01;
+                end else if (cfg_weight_base[2:0] != 0 || cfg_scale_base[2:0] != 0 ||
+                             cfg_wend > 64'd536870912 || cfg_send > 64'd536870912 ||
+                             !(cfg_wend <= {35'd0, cfg_scale_base} ||
+                               cfg_send <= {35'd0, cfg_weight_base})) begin
+                    cfg_error <= 1'b1;
+                    cfg_error_code <= 8'h03;
+                end else begin
+                    configured <= 1'b1;
+                    active_n <= cfg_n;
+                    active_k <= cfg_k;
+                    weight_base <= cfg_weight_base;
+                    scale_base <= cfg_scale_base;
+                    weight_words <= cfg_rw[15:0];
+                    scale_words <= cfg_rs[15:0];
+                    n_groups <= cfg_groups[15:0];
+                    k_blocks <= ({1'b0, cfg_k} + 17'd127) >> 7;
+                end
+            end else begin
+                case (state)
+                    S_IDLE: begin
+                        if (load_valid && load_ready) begin
+                            if ((load_kind && load_index >= active_n) ||
+                                (!load_kind && load_index >= n_groups) ||
+                                index_base >= 64'd536870912) begin
+                                fault <= 1'b1;
+                                error_code <= 8'h40;
+                            end else begin
+                                kind <= load_kind;
+                                object_base <= index_base[28:0];
+                                total_words <= load_kind ? weight_words : scale_words;
+                                offset <= 16'd0;
+                                state <= S_INIT;
+                            end
+                        end
+                    end
+                    S_INIT: state <= S_REQUEST;
+                    S_REQUEST: begin
+                        if (cmd_beats == 0 || segment_end >= 64'd536870912) begin
+                            fault <= 1'b1;
+                            error_code <= 8'h20;
+                        end else if (cmd_ready) begin
+                            state <= S_RECEIVE;
+                        end
+                    end
+                    S_RECEIVE: begin
+                        if (range_done)
+                            state <= S_COMMIT;
+                    end
+                    S_COMMIT: begin
+                        if (offset + cmd_beats == total_words) begin
+                            state <= S_LOADED;
+                        end else begin
+                            offset <= offset + cmd_beats;
+                            state <= S_REQUEST;
+                        end
+                    end
+                    S_LOADED: begin
+                        if (buffer_loaded) begin
+                            load_done_reg <= 1'b1;
+                            state <= S_IDLE;
+                        end
+                    end
+                    default: begin
+                        fault <= 1'b1;
+                        error_code <= 8'h40;
+                    end
+                endcase
+            end
+        end
+    end
+endmodule
diff --git a/rtl/xw_weight_row_buffer.v b/rtl/xw_weight_row_buffer.v
new file mode 100644
index 0000000..4d8ec79
--- /dev/null
+++ b/rtl/xw_weight_row_buffer.v
@@ -0,0 +1,135 @@
+// Stage 3: raw FP8 complete row, 512-bit DDR write / 8-byte B1 read.
+module xw_weight_row_buffer #(
+    parameter integer MAX_K = 12288
+)(
+    input  wire         clk,
+    input  wire         rst_n,
+    input  wire         abort,
+    input  wire         load_begin,
+    input  wire  [15:0] load_k,
+    input  wire         wr_valid,
+    input  wire [511:0] wr_data,
+    input  wire  [15:0] wr_word_index,
+    output wire         loaded,
+    output reg          fault,
+    output reg    [7:0] error_code,
+    input  wire         rd_req,
+    input  wire  [15:0] rd_word_index,
+    output wire         rd_valid,
+    output wire  [63:0] rd_data,
+    output reg    [7:0] rd_mask
+);
+
+    // 单拍全宽写入，容量覆盖连续且无 Ready 的所有 DDR 返回。
+    localparam integer DEPTH = (MAX_K + 63) / 64;
+    reg [511:0] words [0:DEPTH-1];
+    reg [511:0] ram_read_word;
+    reg   [2:0] read_lane;
+    reg         read_seen;
+    reg         loading;
+    reg         loaded_reg;
+    reg         read_valid_reg;
+    reg  [15:0] active_k;
+    reg  [15:0] total_words;
+    reg  [15:0] read_words;
+    reg  [15:0] written;
+    wire  [7:0] read_mask;
+    wire [63:0] selected_bytes;
+    wire        control_conflict;
+    wire        invalid_write;
+    wire        write_enable;
+    wire        read_enable;
+    genvar lane;
+
+    generate
+        if (MAX_K < 1 || MAX_K > 65535) begin : g_invalid_parameters
+            XW_INVALID_WEIGHT_BUFFER_PARAMETERS u_must_fail_elaboration ();
+        end
+    endgenerate
+
+    assign loaded = rst_n && !abort && !fault && loaded_reg;
+    assign rd_valid = rst_n && !abort && !fault && read_valid_reg;
+    assign read_mask = rd_word_index + 16'd1 == read_words && active_k[2:0] != 0 ?
+                       (8'hff >> (8 - active_k[2:0])) : 8'hff;
+    assign selected_bytes = ram_read_word >> (read_lane * 64);
+    generate
+        for (lane = 0; lane < 8; lane = lane + 1) begin : g_read_lane_mask
+            assign rd_data[lane*8 +: 8] = read_seen && rd_mask[lane] ? selected_bytes[lane*8 +: 8] : 8'd0;
+        end
+    endgenerate
+    assign control_conflict = (load_begin && (loading || wr_valid || rd_req)) ||
+                              (wr_valid && rd_req) ||
+                              (load_begin && (load_k == 0 || load_k > MAX_K)) ||
+                              (rd_req && (!loaded_reg || rd_word_index >= read_words));
+    assign invalid_write = !loading || wr_word_index != written || written >= total_words || written >= DEPTH;
+    assign write_enable = rst_n && !abort && !fault && !control_conflict &&
+                          !load_begin && wr_valid && !invalid_write;
+    assign read_enable = rst_n && !abort && !fault && !control_conflict &&
+                         !load_begin && !wr_valid && rd_req;
+
+    // 原生512bit同步RAM读后选择8-byte，lane与mask同沿寄存。
+    always @(posedge clk) begin
+        if (write_enable)
+            words[wr_word_index] <= wr_data;
+        if (read_enable)
+            ram_read_word <= words[rd_word_index >> 3];
+    end
+
+    // 有效位复位，RAM 无全阵列清零；读写并发定义为内部错误。
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            loading <= 1'b0;
+            loaded_reg <= 1'b0;
+            read_valid_reg <= 1'b0;
+            fault <= 1'b0;
+            error_code <= 8'd0;
+            active_k <= 16'd0;
+            total_words <= 16'd0;
+            read_words <= 16'd0;
+            written <= 16'd0;
+            read_seen <= 1'b0;
+            read_lane <= 3'd0;
+            rd_mask <= 8'd0;
+        end else begin
+            read_valid_reg <= 1'b0;
+            if (fault || abort) begin
+                loading <= 1'b0;
+                loaded_reg <= 1'b0;
+                if (!fault) begin
+                    fault <= 1'b1;
+                    error_code <= 8'h40;
+                end
+            end else if (control_conflict) begin
+                fault <= 1'b1;
+                error_code <= 8'h40;
+                loading <= 1'b0;
+                loaded_reg <= 1'b0;
+            end else if (load_begin) begin
+                loading <= 1'b1;
+                loaded_reg <= 1'b0;
+                active_k <= load_k;
+                total_words <= ({1'b0, load_k} + 17'd63) >> 6;
+                read_words <= ({1'b0, load_k} + 17'd7) >> 3;
+                written <= 16'd0;
+            end else if (wr_valid) begin
+                if (invalid_write) begin
+                    fault <= 1'b1;
+                    error_code <= 8'h23;
+                    loading <= 1'b0;
+                    loaded_reg <= 1'b0;
+                end else begin
+                    written <= written + 16'd1;
+                    if (written + 16'd1 == total_words) begin
+                        loading <= 1'b0;
+                        loaded_reg <= 1'b1;
+                    end
+                end
+            end else if (rd_req) begin
+                read_seen <= 1'b1;
+                read_lane <= rd_word_index[2:0];
+                rd_mask <= read_mask;
+                read_valid_reg <= 1'b1;
+            end
+        end
+    end
+endmodule
diff --git a/run_stage23_tb.sh b/run_stage23_tb.sh
new file mode 100755
index 0000000..7a3b10f
--- /dev/null
+++ b/run_stage23_tb.sh
@@ -0,0 +1,7 @@
+#!/bin/sh
+# Real HDL only passes when every PRE/NBA record and every PASS check succeeds.
+set -eu
+ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
+cd "$ROOT"
+python3 tools/gen_stage23_tb.py --check
+python3 tools/run_stage23.py
diff --git a/stage23_golden.py b/stage23_golden.py
new file mode 100644
index 0000000..df155c4
--- /dev/null
+++ b/stage23_golden.py
@@ -0,0 +1,75 @@
+"""Independent data-level oracles. No imports from any cycle/RTL model.
+
+AXIS stimulus is constructed bit-by-bit and headers via little-endian bytes;
+DDR regions are constructed in byte coordinates before converting to address
+units. This intentionally differs from the RTL shifts/range arithmetic.
+"""
+import struct
+
+
+def axis_tensor(values, exponents, job_id):
+    assert 1 <= len(values) <= 65535
+    assert len(exponents) == (len(values) + 127) // 128
+    records = []
+    for g, begin in enumerate(range(0, len(values), 128)):
+        group = values[begin:begin + 128]
+        for offset in range(0, len(group), 28):
+            part = group[offset:offset + 28]
+            bits = [0] * 512
+            for i, value in enumerate(part):
+                assert -131072 <= value <= 131071
+                raw = value % 262144
+                for b in range(18):
+                    bits[i * 18 + b] = raw // (2 ** b) % 2
+            payload = int(''.join(map(str, reversed(bits))), 2)
+            last = offset + len(part) == len(group)
+            header = bytearray(16)
+            header[0:4] = struct.pack('<I', job_id)
+            header[6:8] = struct.pack('<H', g)
+            header[8] = exponents[g] % 256
+            header[9] = len(group)
+            header[10] = offset
+            header[11] = int(last and begin + len(group) == len(values))
+            header[12] = 0xb2
+            used = (len(part) * 18 + 7) // 8
+            keep = int('0' * (64-used) + '1' * used, 2)
+            records.append(dict(s_axis_tdata=payload, s_axis_tkeep=keep,
+                                s_axis_tlast=int(last),
+                                s_axis_tuser=int.from_bytes(header, 'little')))
+    return records
+
+
+def activation_words(values, exponents):
+    result = []
+    for i in range(0, len(values), 8):
+        lanes = values[i:i+8]
+        # String concatenation gives an independent two's-complement packing.
+        s = ''.join(f'{v % 262144:018b}' for v in reversed(lanes))
+        result.append((int(s, 2), (2 ** len(lanes))-1, exponents[i//128] % 256))
+    return result
+
+
+def layout(n, k, wb, sb):
+    if not (1 <= n <= 65535 and 1 <= k <= 65535):
+        return 1, []
+    # Convert address units to byte positions first; regions are half-open.
+    row_bytes = ((k + 63) // 64) * 64
+    scale_bytes = ((((k+127)//128)*4 + 63)//64)*64
+    wr = (wb*8, wb*8+n*row_bytes)
+    sr = (sb*8, sb*8+((n+127)//128)*scale_bytes)
+    if wb % 8 or sb % 8 or min(wb, sb) < 0 or max(wr[1],sr[1]) > 2**32:
+        return 3, []
+    if max(wr[0],sr[0]) < min(wr[1],sr[1]):
+        return 3, []
+    objects = [(0, g, (sr[0]+g*scale_bytes)//8, scale_bytes//64)
+               for g in range((n+127)//128)]
+    objects += [(1, r, (wr[0]+r*row_bytes)//8, row_bytes//64) for r in range(n)]
+    return 0, objects
+
+
+def ranges(base, words, burst):
+    # Enumerate all beat addresses then partition, independently of gen FSM.
+    addresses = list(range(base, base+words*8, 8))
+    return [(a[0], a[-1], len(a), p)
+            for p in range(0, len(addresses), burst)
+            for a in [addresses[p:p+burst]]]
